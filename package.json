{
  "name": "playlist-data-showcase",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:css:fix": "stylelint \"src/**/*.css\" --fix",
    "check:css": "node scripts/check-css-braces.js",
    "deps:check": "node scripts/depAge.cjs check",
    "deps:audit": "node scripts/depAge.cjs check --all",
    "deps:add": "node scripts/depAge.cjs add"
  },
  "dependencies": {
    "@types/howler": "2.2.12",
    "howler": "2.2.4",
    "localforage": "1.10.0",
    "lucide-react": "0.468.0",
    "playlist-data-engine": "1.6.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.3",
    "react-window": "2.2.7",
    "recharts": "3.8.1",
    "zod": "3.25.76",
    "zustand": "5.0.10"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "20.19.30",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "@types/react-window": "1.8.8",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.4.23",
    "husky": "9.1.7",
    "jsdom": "28.1.0",
    "lint-staged": "15.5.2",
    "postcss": "8.5.6",
    "stylelint": "17.0.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "5.9.3",
    "vite": "5.4.21",
    "vite-plugin-node-polyfills": "0.26.0",
    "vitest": "4.0.18"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "bash -c 'tsc --noEmit'"
    ],
    "*.css": [
      "stylelint --fix",
      "git add"
    ]
  }
}
